# CloudCLI, Sandlot build: environment contract (docs/sandlot/README.md).
# The server refuses to start when a required value is missing or malformed.

# Bind address. Default 127.0.0.1: reach it through a local proxy, never 0.0.0.0.
HOST=127.0.0.1
# TCP port (Sandlot uses 8091).
SERVER_PORT=8091
# Path prefix for static files, API and WebSockets ('' serves at /).
CLOUDCLI_BASE_PATH=/absproxy/8091

# Required: sha256 of the login password, 64 lowercase hex.
#   printf %s 'the-password' | sha256sum
SANDLOT_PASSWORD_SHA256=

# Required: absolute path to the Claude Code executable.
CLAUDE_CLI_PATH=/opt/claude/bin/claude

# Optional: touched at least every 60 s while a client is connected.
# CLOUDCLI_HEARTBEAT_FILE=/run/user/1000/cloudcli.heartbeat

# SQLite database file, or a directory for auth.db (dir 0700, file 0600).
# DATABASE_PATH=~/.local/share/cloudcli/auth.db

# Optional: ripgrep for conversation search (else `rg` on PATH).
# CLOUDCLI_RG_PATH=/usr/lib/code-server/lib/vscode/node_modules/@vscode/ripgrep/bin/rg

# Vite dev server port (development only).
VITE_PORT=5173
